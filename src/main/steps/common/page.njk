{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}

{% extends "govuk/template.njk" %}

{% block head %}
{% include "./webpack/gtm-script.njk" %}
{% include "./webpack/css.njk" %}
<!-- {{ userCase.id }} -->
<!-- Dynatrace -->
  <script type="text/javascript" src="{{ globals.dynatrace.dynatraceUrl }}" crossorigin="anonymous"></script>
<!-- End Dynatrace -->
{% endblock %}

{% block govukHeader %}
  <div class="app-header">
    <div class="govuk-width-container app-header__container">
      {{ govukHeader({ containerClasses: "app-header__logo-container" }) }}
      {% block serviceHeader %}
        <nav class="app-header__navigation" aria-label="{{ serviceName }}">
          <a class="govuk-link govuk-link--inverse app-header__service-name" href="{{ (globals.basePath if globals.basePath) + '/' }}">{{ serviceName }}</a>
          <a class="govuk-link govuk-link--inverse app-header__account-link" href="{{ '/logout' if isLoggedIn else '/' }}">{{ signOut if isLoggedIn else signIn }}</a>
        </nav>
      {% endblock %}
    </div>
  </div>
{% endblock %}

{% block govukServiceNavigation %}{% endblock %}

{% block headerEnd %}
  {{ govukPhaseBanner({
    tag: {
      text: phase
    },
    html: feedback |replace("currentUrl",currentUrl) + languageToggle
  }) }}
{% endblock %}

{% block pageTitle %}
  {% if (sessionErrors and (sessionErrors.length > 0)) or (FileErrors and (FileErrors.length > 0)) %}
    {{errorPrefix}} {{ serviceName }} - {{ title }} - {{ govUk }}
  {% else %}
    {{ serviceName }} - {{ title }} - {{ govUk }}
  {% endif %}
{% endblock %}

{% block bodyStart %}
{% include "./webpack/gtm-noscript.njk" %}
{% endblock %}

{% block govukSkipLink %}
{{ super() }}
{% include "../cookie-banner/template.njk" %}
{% endblock %}

{% block beforeContent %}
  {% block backLink %}
    <a href="#" class="govuk-back-link">{{ back }}</a>
  {% endblock %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% block error_summary %}
        {% include "common/error/summary.njk" %}
      {% endblock %}

      {% block page_content%}
        {% if title %}
          <h1 class="govuk-heading-l govuk-!-margin-bottom-2">{{ title }}</h1>
        {% endif %}
      {% endblock %}

      {% if form %}
        {% block form %}
          {% include "common/form/form.njk"%}
        {% endblock %}
      {% endif %}

      {# TODO uncomment this once we have contact us content #}
      {# {% block contact_us %}
        {% include "./contact-us.njk" %}
      {% endblock %} #}
    </div>
  </div>
{% endblock %}

{% block govukFooter %}
  {{ govukFooter({
    copyright: {
      text: copyright | safe
    },
    contentLicence: {
      text: ogl | safe
    },
    meta: {
      items: [
        {
          href: "/cookies",
          text: cookies
        },
        {
          href: "/privacy-policy",
          text: privacyPolicy
        },
        {
          href: "/accessibility-statement",
          text: accessibility
        },
        {
          href: "/terms-and-conditions",
          text: termsAndConditions
        },
        {
          href: "/contact-us",
          text: contactUs
        }
      ]
    }
  }) }}
{% endblock %}

{% block bodyEnd %}
  {# Run JavaScript at end of the <body>, to avoid blocking the initial render. #}
  {% include "./webpack/js.njk" %}
{% endblock %}
