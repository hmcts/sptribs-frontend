{% extends "common/page.njk" %}

{% block serviceHeader %}
  <nav class="app-header__navigation" aria-label="{{ serviceName }}">
    <a class="govuk-link govuk-link--inverse app-header__service-name" href="{{ (globals.basePath if globals.basePath) + '/' }}">{{ serviceName }}</a>
  </nav>
{% endblock %}

{% block backLink %}{% endblock %}

{% block page_content %}
  <h1 class="govuk-heading-xl">{{ title }}</h1>
  <p class="govuk-body">{{ line1 }}</p>
  <p class="govuk-body">{{ line2 }}</p>
  <p class="govuk-body"><a class="govuk-link" href="/login">{{ signBackInAndContinue }}</a></p>
{% endblock %}
